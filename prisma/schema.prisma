// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String?  @db.Text // Markdown content for detail page
  thumbnail   String
  images      String[] // Array of image URLs
  link        String?
  category    String?  // Category: Backend, Frontend, FullStack, etc.
  tags        String[] // Tags: ABAP, Java, React, etc.
  bgmUrl      String?  // Background music URL for detail page
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Writing {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String?  @db.Text // Markdown content for detail page
  thumbnail   String
  images      String[] // Array of image URLs
  link        String?
  category    String?  // Category: Tech, Daily, Backend, etc.
  tags        String[] // Tags: ABAP, Node.js, Thoughts, etc.
  bgmUrl      String?  // Background music URL for detail page
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("writings")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  author    String
  content   String   @db.Text
  files     Json?    // Store files as JSON array: [{name: string, url: string}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model Guestbook {
  id        String   @id @default(cuid())
  name      String
  message   String   @db.Text
  isPublic  Boolean  @default(true) // true = public, false = private
  approved  Boolean  @default(false) // Admin approval
  createdAt DateTime @default(now())

  @@map("guestbook")
}
